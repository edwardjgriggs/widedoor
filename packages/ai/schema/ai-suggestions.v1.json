{
  "$id": "urn:widedoor:schema:ai-suggestions:v1",
  "title": "Widedoor AI Suggestions v1",
  "description": "Optional AI fix suggestions for the failed findings of one Widedoor scan report, with exactly what was sent for each. AI-generated; never changes a result in the report.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "$id": {
      "type": "string",
      "const": "urn:widedoor:schema:ai-suggestions:v1"
    },
    "label": {
      "type": "string",
      "const": "AI-generated. Review before use. Suggestions do not change any result in the report."
    },
    "provider": {
      "type": "string",
      "enum": [
        "anthropic",
        "openai"
      ]
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "modelAnswered": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "report": {
      "type": "object",
      "properties": {
        "startedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "findings": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "startedAt",
        "findings"
      ],
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "properties": {
        "maxGroups": {
          "default": 25,
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "maxRequestsPerMinute": {
          "default": 10,
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "concurrency": {
          "default": 2,
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "maxOutputTokens": {
          "default": 4096,
          "type": "integer",
          "minimum": 256,
          "maximum": 16384
        },
        "maxInputTokensTotal": {
          "default": 200000,
          "type": "integer",
          "minimum": 1000,
          "maximum": 5000000
        }
      },
      "required": [
        "maxGroups",
        "maxRequestsPerMinute",
        "concurrency",
        "maxOutputTokens",
        "maxInputTokensTotal"
      ],
      "additionalProperties": false
    },
    "entries": {
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "group": {
            "type": "string",
            "pattern": "^[0-9a-f]{16}$"
          },
          "findingIds": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^wd_[0-9a-f]{16}$"
            }
          },
          "request": {
            "type": "object",
            "properties": {
              "ruleId": {
                "type": "string",
                "minLength": 1
              },
              "criteria": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "assetKind": {
                "type": "string",
                "enum": [
                  "web",
                  "pdf"
                ]
              },
              "selector": {
                "type": "string",
                "minLength": 1
              },
              "snippet": {
                "type": "string",
                "minLength": 1
              },
              "page": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "structPath": {
                "type": "string",
                "minLength": 1
              },
              "plain": {
                "type": "object",
                "properties": {
                  "what": {
                    "type": "string",
                    "minLength": 1
                  },
                  "fix": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "what",
                  "fix"
                ],
                "additionalProperties": false
              },
              "reportRule": {
                "type": "string",
                "minLength": 1
              },
              "reportCriteria": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "redactions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "minLength": 1
                    },
                    "count": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "kind",
                    "count"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "ruleId",
              "criteria",
              "assetKind",
              "redactions"
            ],
            "additionalProperties": false
          },
          "delivered": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "refused",
              "invalid",
              "error",
              "skipped-budget",
              "not-sent"
            ]
          },
          "suggestion": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "web-patch"
                  },
                  "summary": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 400
                  },
                  "patch": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000
                  },
                  "notes": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000
                  }
                },
                "required": [
                  "kind",
                  "summary",
                  "patch"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "pdf-steps"
                  },
                  "summary": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 400
                  },
                  "tool": {
                    "type": "string",
                    "enum": [
                      "word",
                      "indesign",
                      "acrobat",
                      "other"
                    ]
                  },
                  "steps": {
                    "minItems": 1,
                    "maxItems": 12,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 400
                    }
                  }
                },
                "required": [
                  "kind",
                  "summary",
                  "tool",
                  "steps"
                ],
                "additionalProperties": false
              }
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "usage": {
            "type": "object",
            "properties": {
              "inputTokens": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "outputTokens": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "inputTokens",
              "outputTokens"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "group",
          "findingIds",
          "request",
          "delivered",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "totals": {
      "type": "object",
      "properties": {
        "requests": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "inputTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "outputTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "skippedGroups": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "requests",
        "inputTokens",
        "outputTokens",
        "skippedGroups"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "$id",
    "label",
    "provider",
    "model",
    "createdAt",
    "report",
    "limits",
    "entries",
    "totals"
  ],
  "additionalProperties": false
}
