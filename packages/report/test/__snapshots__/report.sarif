{
  "$schema": "https://docs.oasis-open.org/sarif/sarif/v2.1.0/errata01/os/schemas/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Widedoor",
          "version": "0.0.0",
          "rules": [
            {
              "id": "axe-core/color-contrast",
              "name": "color-contrast",
              "shortDescription": {
                "text": "Text does not stand out enough from its background."
              },
              "fullDescription": {
                "text": "Text does not stand out enough from its background. People with low vision or color blindness may not be able to read it."
              },
              "help": {
                "text": "Make the text darker or the background lighter. Aim for a contrast ratio of at least 4.5 to 1."
              },
              "helpUri": "https://dequeuniversity.com/rules/axe/4.14/color-contrast",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "accessibility",
                  "WCAG 1.4.3"
                ],
                "engine": "axe-core",
                "wcag": [
                  "1.4.3"
                ]
              }
            },
            {
              "id": "axe-core/label",
              "name": "label",
              "shortDescription": {
                "text": "A form field has no label."
              },
              "fullDescription": {
                "text": "A form field has no label. Screen reader users do not know what to type."
              },
              "help": {
                "text": "Add a label tag that names the field and points to it."
              },
              "helpUri": "https://dequeuniversity.com/rules/axe/4.14/label",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "accessibility",
                  "WCAG 4.1.2"
                ],
                "engine": "axe-core",
                "wcag": [
                  "4.1.2"
                ]
              }
            },
            {
              "id": "axe-core/link-name",
              "name": "link-name",
              "shortDescription": {
                "text": "A link has no text."
              },
              "fullDescription": {
                "text": "A link has no text. Screen reader users hear link but not where it goes."
              },
              "help": {
                "text": "Add link text, or add alt text to the image inside the link."
              },
              "helpUri": "https://dequeuniversity.com/rules/axe/4.14/link-name",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "accessibility",
                  "WCAG 2.4.4",
                  "WCAG 4.1.2"
                ],
                "engine": "axe-core",
                "wcag": [
                  "2.4.4",
                  "4.1.2"
                ]
              }
            },
            {
              "id": "verapdf/7.3-1",
              "name": "7.3-1",
              "shortDescription": {
                "text": "An image has no alt text."
              },
              "fullDescription": {
                "text": "An image has no alt text. Screen reader users miss what the image shows."
              },
              "help": {
                "text": "Add alt text to the image in Acrobat, or in the program you made the file with."
              },
              "helpUri": "https://www.w3.org/WAI/WCAG21/Understanding/non-text-content.html",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "accessibility",
                  "WCAG 1.1.1"
                ],
                "engine": "verapdf",
                "wcag": [
                  "1.1.1"
                ]
              }
            },
            {
              "id": "widedoor/pdf-title-displayed",
              "name": "pdf-title-displayed",
              "shortDescription": {
                "text": "The PDF does not show a title in its window."
              },
              "fullDescription": {
                "text": "The PDF does not show a title in its window. Screen reader users hear a file name that may not say what the file is."
              },
              "help": {
                "text": "Add a title in the file properties and set the file to show it."
              },
              "helpUri": "https://www.w3.org/WAI/WCAG21/Understanding/page-titled.html",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "accessibility",
                  "WCAG 2.4.2"
                ],
                "engine": "widedoor",
                "wcag": [
                  "2.4.2"
                ]
              }
            }
          ]
        },
        "extensions": [
          {
            "name": "axe-core",
            "version": "4.14.0"
          },
          {
            "name": "veraPDF",
            "version": "1.30.3"
