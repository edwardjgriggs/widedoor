          "rules": [
            {
              "id": "axe-core/color-contrast",
              "name": "color-contrast",
              "shortDescription": {
                "text": "Text does not stand out enough from its background."
              },
              "fullDescription": {
                "text": "Text does not stand out enough from its background. People with low vision or color blindness may not be able to read it."
              },
              "help": {
                "text": "Make the text darker or the background lighter. Aim for a contrast ratio of at least 4.5 to 1."
              },
              "helpUri": "https://dequeuniversity.com/rules/axe/4.14/color-contrast",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "accessibility",
                  "WCAG 1.4.3"
                ],
                "engine": "axe-core",
                "wcag": [
                  "1.4.3"
                ]
              }
            },
            {
              "id": "axe-core/image-alt",
              "name": "image-alt",
              "shortDescription": {
                "text": "An image has no text alternative."
              },
              "fullDescription": {
                "text": "An image has no text alternative. Screen reader users miss what the image shows."
              },
              "help": {
                "text": "Add alt text that says what the image shows. Use empty alt text for images that are only for looks."
              },
              "helpUri": "https://dequeuniversity.com/rules/axe/4.14/image-alt",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "accessibility",
                  "WCAG 1.1.1"
                ],
                "engine": "axe-core",
                "wcag": [
                  "1.1.1"
                ]
              }
            },
            {
              "id": "verapdf/7.3-1",
              "name": "7.3-1",
              "shortDescription": {
                "text": "An image has no alt text."
              },
              "fullDescription": {
                "text": "An image has no alt text. Screen reader users miss what the image shows."
              },
              "help": {
                "text": "Add alt text to the image in Acrobat, or in the program you made the file with."
              },
              "helpUri": "https://www.w3.org/WAI/WCAG21/Understanding/non-text-content.html",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "accessibility",
                  "WCAG 1.1.1"
                ],
                "engine": "verapdf",
                "wcag": [
                  "1.1.1"
                ]
              }
            }
          ]
